/* pages/index/index.wxss */
.page { min-height: 100vh; background: #f5f5f5; padding-bottom: 190rpx; }

/* 搜索栏 */
.search-bar {
  display: flex; align-items: center; padding: 20rpx 24rpx;
  background: #7C6BC0; position: sticky; top: 0; z-index: 10;
}
.search-input-wrap {
  flex: 1; display: flex; align-items: center;
  background: #fff; border-radius: 40rpx; padding: 0 24rpx; height: 68rpx;
}
.search-input { flex: 1; font-size: 28rpx; }
.search-clear { color: #bbb; padding-left: 16rpx; }
.search-btn { color: #fff; font-size: 28rpx; padding-left: 24rpx; }

/* 搜索面板（历史+热门）——从搜索栏下方展开，不遮挡搜索栏/占位符 */
.search-mask {
  position: fixed; left: 0; right: 0; top: 108rpx; bottom: 0;
  background: rgba(0,0,0,0.35); z-index: 150;
}
.search-panel {
  background: #fff; padding: 24rpx 24rpx 40rpx;
  border-radius: 0 0 24rpx 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.1);
}
.sp-section { margin-top: 20rpx; }
.sp-head {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 16rpx;
}
.sp-title { font-size: 28rpx; font-weight: 600; color: #333; }
.sp-clear { font-size: 24rpx; color: #999; }
.sp-tags { display: flex; flex-wrap: wrap; }
.sp-tag {
  display: inline-flex; align-items: center;
  padding: 12rpx 24rpx; margin: 0 16rpx 16rpx 0;
  font-size: 25rpx; border-radius: 30rpx;
}
.sp-tag.history { background: #f2f2f2; color: #555; }
.sp-tag.hot { background: #EFEBF9; color: #7C6BC0; }
.sp-del { margin-left: 8rpx; color: #bbb; font-size: 22rpx; }

/* 分类栏 */
.cat-wrap {
  position: relative; display: flex; align-items: center;
  background: #fff; padding: 16rpx 0;
}
.cat-bar {
  white-space: nowrap; flex: 1; min-width: 0;
  padding-right: 130rpx; /* 给右侧按钮留位，防被滚动内容覆盖 */
}
.cat-item {
  display: inline-block; padding: 10rpx 32rpx; margin: 0 8rpx;
  font-size: 26rpx; color: #555; background: #f2f2f2; border-radius: 30rpx;
}
.cat-item.active { background: #7C6BC0; color: #fff; }
.cat-more {
  position: absolute; right: 16rpx; top: 50%; transform: translateY(-50%);
  height: 64rpx; padding: 0 20rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 26rpx; color: #7C6BC0; background: #EFEBF9;
  border-radius: 32rpx; z-index: 5;
}

/* 全部分类弹出面板 */
.cat-mask {
  position: fixed; left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.4); z-index: 200;
  display: flex; align-items: flex-end;
}
.cat-panel {
  width: 100%; background: #fff; border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 24rpx 190rpx; /* 底部留白，避让自定义tabBar(110rpx+安全区) */
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.08);
}
.cat-panel-title { font-size: 30rpx; font-weight: 600; color: #333; margin-bottom: 24rpx; }
.cat-grid { display: flex; flex-wrap: wrap; }
.cat-cell {
  width: 30%; margin: 0 1.5% 20rpx; padding: 20rpx 0;
  text-align: center; font-size: 28rpx; color: #555;
  background: #f2f2f2; border-radius: 16rpx;
}
.cat-cell.active { background: #7C6BC0; color: #fff; font-weight: 600; }

/* 二级分类标签（电子资料细分） */
.subcat-bar { white-space: nowrap; background: #f9f8fd; padding: 12rpx 0; border-bottom: 1rpx solid #f0eef7; }
.subcat-item {
  display: inline-block; padding: 8rpx 28rpx; margin: 0 10rpx;
  font-size: 24rpx; color: #777; background: #fff;
  border: 1rpx solid #e5e1f2; border-radius: 26rpx;
}
.subcat-item.active { background: #7C6BC0; color: #fff; border-color: #7C6BC0; font-weight: 600; }

/* 三级分类（学科）标签栏：颜色稍浅以区分层级 */
.thirdcat-bar { white-space: nowrap; background: #f3f1fa; padding: 10rpx 0; border-bottom: 1rpx solid #f0eef7; }
.thirdcat-item {
  display: inline-block; padding: 6rpx 24rpx; margin: 0 8rpx;
  font-size: 22rpx; color: #888; background: #fff;
  border: 1rpx solid #ebe8f5; border-radius: 22rpx;
}
.thirdcat-item.active { background: #C9971C; color: #fff; border-color: #C9971C; font-weight: 600; }

/* 排序条 */
.sort-bar {
  display: flex; background: #fff; padding: 0 24rpx 16rpx;
  border-bottom: none;
}
.sort-item {
  font-size: 26rpx; color: #555; margin-right: 36rpx;
  padding-bottom: 6rpx;
}
.sort-item.active { color: #7C6BC0; font-weight: 600; }

/* 未登录引导条 */
.login-tip {
  display: flex; align-items: center;
  margin: 16rpx 24rpx; padding: 20rpx 24rpx;
  background: #FFF7E6; border: 1rpx solid #FFE3A3;
  border-radius: 12rpx;
}
.tip-icon { font-size: 28rpx; margin-right: 12rpx; }
.tip-text { flex: 1; font-size: 26rpx; color: #8a6d1a; }
.tip-action {
  font-size: 26rpx; color: #C9971C; font-weight: 600;
  margin-left: 12rpx;
}

/* 卡片 */
.list { padding: 20rpx 24rpx; }
.card {
  display: flex; background: #fff; border-radius: 16rpx; padding: 20rpx;
  margin-bottom: 20rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.cover {
  width: 160rpx; height: 160rpx; border-radius: 12rpx;
  background: #f0f0f0; flex-shrink: 0;
}
.cover.no-img {
  display: flex; align-items: center; justify-content: center;
  font-size: 64rpx; color: #ccc;
}
.card-body { flex: 1; margin-left: 20rpx; overflow: hidden; }
.card-title { font-size: 30rpx; font-weight: 600; color: #333; 
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.card-desc { font-size: 26rpx; color: #888; margin-top: 8rpx;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.card-meta { display: flex; align-items: center; margin-top: 12rpx; }
.price { color: #C9971C; font-size: 36rpx; font-weight: 700; letter-spacing: 1rpx; }
.tag { margin-left: auto; font-size: 22rpx; color: #7C6BC0;
  background: #EFEBF9; padding: 4rpx 16rpx; border-radius: 20rpx; }
.card-foot { display: flex; justify-content: space-between; margin-top: 10rpx; }
.seller { font-size: 24rpx; color: #666; }
.time { font-size: 22rpx; color: #aaa; }

/* 空态 */
.empty { text-align: center; padding: 200rpx 0; }
.empty-icon { font-size: 100rpx; }
.empty-text { color: #999; font-size: 28rpx; margin-top: 20rpx; }
.empty-btn {
  display: inline-block; margin-top: 40rpx; padding: 16rpx 60rpx;
  background: #7C6BC0; color: #fff; font-size: 30rpx;
  border-radius: 40rpx; font-weight: 600;
}

/* 列表脚 */
.list-end { text-align: center; color: #bbb; font-size: 24rpx; padding: 30rpx 0; }
.list-loading { text-align: center; color: #999; font-size: 24rpx; padding: 20rpx 0; }

/* 骨架屏 */
.skeleton-list { padding: 20rpx 24rpx; }
.skeleton-card {
  display: flex; background: #fff; border-radius: 16rpx; padding: 20rpx;
  margin-bottom: 20rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.sk-cover {
  width: 160rpx; height: 160rpx; border-radius: 12rpx; background: #e9e9ec;
  flex-shrink: 0;
}
.sk-body { flex: 1; margin-left: 20rpx; padding-top: 8rpx; }
.sk-line { background: #e9e9ec; border-radius: 8rpx; }
.sk-title { width: 70%; height: 32rpx; }
.sk-desc { width: 90%; height: 26rpx; margin-top: 16rpx; }
.sk-row { display: flex; justify-content: space-between; align-items: center; margin-top: 28rpx; }
.sk-price { width: 90rpx; height: 32rpx; }
.sk-tag { width: 120rpx; height: 28rpx; margin-left: auto; }

/* 骨架屏呼吸闪烁动画 */
.skeleton-card .sk-line, .skeleton-card .sk-cover {
  animation: skeleton-blink 1.2s ease-in-out infinite;
}
@keyframes skeleton-blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

/* 悬浮按钮 */
.fab {
  position: fixed; right: 32rpx; bottom: 190rpx;
  width: 100rpx; height: 100rpx; border-radius: 50%;
  background: #7C6BC0; color: #fff; font-size: 60rpx;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 6rpx 20rpx rgba(76,175,80,0.4);
}

/* 回到顶部按钮 */
.back-top {
  position: fixed; right: 36rpx; bottom: 310rpx;
  width: 96rpx; height: 96rpx; border-radius: 50%;
  background: rgba(124,107,192,0.35); color: #7C6BC0; 
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.08);
  z-index: 20;
}
.back-top .arrow { font-size: 28rpx; line-height: 1.1; font-weight: 600; }
.back-top .label { font-size: 20rpx; line-height: 1.2; margin-top: 2rpx; }

/* 列表统计 + 价格类型 + 交易状态 */
.stat { font-size: 22rpx; color: #999; margin-left: 16rpx; }
.stat.flower { color: #d96a8a; }
.price.free, .price.bargain { color: #7C6BC0; }
.tag.sold { background: #eee; color: #999; border-color: #ddd; }

/* 已认证标识（淡紫底包边） */
.verified-badge {
  margin-left: 6rpx; font-size: 22rpx; line-height: 1;
  background: #EFEBF9; color: #7C6BC0;
  border: 1rpx solid #d9d2f0; border-radius: 10rpx;
  padding: 4rpx 8rpx; display: inline-block;
}

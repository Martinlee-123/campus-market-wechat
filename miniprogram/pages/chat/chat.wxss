/* pages/chat/chat.wxss */
.page { display: flex; flex-direction: column; height: 100vh; background: #f5f5f5; }
.goods-bar {
  padding: 14rpx 24rpx; background: #fdf6e3; color: #8a6d3b;
  font-size: 24rpx; border-bottom: 1rpx solid #eee;
}
.msg-list { flex: 1; overflow-y: auto; padding: 24rpx; }
.loading { text-align: center; color: #999; padding: 40rpx 0; }
.row { display: flex; flex-direction: column; margin-bottom: 24rpx; }
.row.other { align-items: flex-start; }
.row.mine { align-items: flex-end; }
.bubble {
  max-width: 70%;
  padding: 18rpx 24rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  line-height: 1.5;
  word-break: break-all;
}
.row.other .bubble { background: #fff; color: #333; border-top-left-radius: 4rpx; }
.row.mine .bubble { background: #7C6BC0; color: #fff; border-top-right-radius: 4rpx; }
.time { font-size: 20rpx; color: #bbb; margin-top: 6rpx; }

.input-bar {
  display: flex; align-items: center;
  padding: 16rpx 24rpx;
  background: #fff; border-top: 1rpx solid #eee;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
}
.input {
  flex: 1; height: 72rpx;
  background: #f5f5f5; border-radius: 36rpx;
  padding: 0 28rpx; font-size: 28rpx;
}
.send-btn {
  margin-left: 16rpx;
  background: #7C6BC0; color: #fff;
  font-size: 28rpx; border-radius: 36rpx;
  padding: 0 32rpx; line-height: 72rpx; height: 72rpx;
}
.send-btn::after { border: none; }
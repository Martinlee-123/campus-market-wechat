/* pages/seller/seller.wxss */
.page { background: #f5f5f5; min-height: 100vh; padding-bottom: 40rpx; }

/* 卖家资料头部 */
.seller-head {
  display: flex; align-items: center;
  padding: 50rpx 32rpx;
  background: linear-gradient(135deg, #7C6BC0, #9A86D9); color: #fff;
}
.avatar { width: 130rpx; height: 130rpx; border-radius: 50%; background: rgba(255,255,255,0.3); }
.avatar.placeholder {
  display: flex; align-items: center; justify-content: center;
  font-size: 72rpx; color: #fff;
}
.head-right { margin-left: 30rpx; flex: 1; }
.block-btn {
  align-self: flex-start; margin-left: 16rpx; flex-shrink: 0;
  font-size: 24rpx; color: #fff;
  background: rgba(255,255,255,0.25);
  border: 2rpx solid rgba(255,255,255,0.6);
  border-radius: 30rpx; padding: 8rpx 22rpx;
}
.block-btn.blocked { background: rgba(0,0,0,0.25); color: #eee; }
.head-name {
  font-size: 38rpx; font-weight: 700; display: flex; align-items: center;
}
.head-flowers { font-size: 26rpx; color: #ffe9f0; margin-top: 12rpx; }

.verified-badge {
  margin-left: 8rpx; font-size: 24rpx; line-height: 1;
  background: rgba(255,255,255,0.25); color: #fff;
  border-radius: 10rpx; padding: 4rpx 10rpx; display: inline-block;
}

.section-title {
  font-size: 28rpx; font-weight: 600; color: #555;
  padding: 24rpx 24rpx 8rpx;
}

/* 商品卡片 */
.list { padding: 8rpx 24rpx; }
.card {
  display: flex; background: #fff; border-radius: 16rpx; padding: 20rpx;
  margin-bottom: 20rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.cover { width: 160rpx; height: 160rpx; border-radius: 12rpx; background: #f0f0f0; flex-shrink: 0; }
.cover.no-img {
  display: flex; align-items: center; justify-content: center;
  font-size: 64rpx; color: #ccc;
}
.card-body { flex: 1; margin-left: 20rpx; overflow: hidden; }
.card-title {
  font-size: 30rpx; font-weight: 600; color: #333;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.card-desc {
  font-size: 26rpx; color: #888; margin-top: 8rpx;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.card-meta { display: flex; align-items: center; margin-top: 12rpx; }
.price { color: #C9971C; font-size: 36rpx; font-weight: 700; }
.tag {
  margin-left: auto; font-size: 22rpx; color: #7C6BC0;
  background: #EFEBF9; padding: 4rpx 16rpx; border-radius: 20rpx;
}
.tag.sold { background: #eee; color: #999; }
.card-foot { display: flex; align-items: center; margin-top: 10rpx; }
.stat { font-size: 24rpx; color: #999; margin-right: 24rpx; }
.stat.flower { color: #d96a8a; }

.empty { text-align: center; padding: 180rpx 0; }
.empty-icon { font-size: 100rpx; }
.empty-text { color: #999; font-size: 28rpx; margin-top: 20rpx; }
.loading { text-align: center; color: #999; font-size: 28rpx; padding-top: 300rpx; }

/* 骨架屏（卖家在售列表） */
.skeleton-list { padding: 8rpx 24rpx; }
.skeleton-card {
  display: flex; background: #fff; border-radius: 16rpx; padding: 20rpx;
  margin-bottom: 20rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.sk-cover { width: 160rpx; height: 160rpx; border-radius: 12rpx; background: #e9e9ec; flex-shrink: 0; }
.sk-body { flex: 1; margin-left: 20rpx; padding-top: 8rpx; }
.sk-line { background: #e9e9ec; border-radius: 8rpx; }
.sk-title { width: 70%; height: 32rpx; }
.sk-desc { width: 90%; height: 26rpx; margin-top: 16rpx; }
.sk-row { display: flex; justify-content: space-between; align-items: center; margin-top: 28rpx; }
.sk-price { width: 90rpx; height: 32rpx; }
.sk-tag { width: 120rpx; height: 28rpx; margin-left: auto; }
.skeleton-card .sk-line, .skeleton-card .sk-cover {
  animation: sk-blink 1.2s ease-in-out infinite;
}
@keyframes sk-blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

.page { background: #f5f5f5; min-height: 100vh; padding-bottom: 60rpx; }

.form { background: #fff; padding: 0 30rpx; }

.row {
  display: flex; align-items: flex-start;
  padding: 28rpx 0; border-bottom: 1rpx solid #f0f0f0;
  flex-direction: column;
}
.row .label { font-size: 28rpx; color: #333; margin-bottom: 12rpx; font-weight: 600; }
.row .input { width: 100%; font-size: 28rpx; padding: 10rpx 0; min-height: 48rpx; }
.row .textarea { width: 100%; font-size: 28rpx; min-height: 160rpx; padding: 10rpx 0; }
.row .picker-value { font-size: 28rpx; color: #333; padding: 10rpx 0; }

.req { color: #e53935; }

.tip { font-size: 24rpx; color: #d32f2f; padding: 24rpx 30rpx; line-height: 1.6; }

.submit-btn {
  margin: 20rpx 30rpx; background: #7C6BC0; color: #fff;
  font-size: 32rpx; border-radius: 48rpx; padding: 22rpx 0;
}

/* 联系方式类型选择 */
.contact-type { display: flex; margin-bottom: 12rpx; }
.ctype-tag {
  padding: 10rpx 32rpx; margin-right: 16rpx;
  font-size: 26rpx; color: #7C6BC0; background: #f4f1fb;
  border: 2rpx solid #d9d2f0; border-radius: 28rpx;
}
.ctype-tag.active { background: #7C6BC0; color: #fff; border-color: #7C6BC0; font-weight: 600; }

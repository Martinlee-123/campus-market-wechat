/* pages/detail/detail.wxss */
.page { background: #f5f5f5; min-height: 100vh; padding-bottom: 160rpx; }

.swiper { width: 100%; height: 600rpx; }
.swiper-img { width: 100%; height: 600rpx; }
.no-img {
  width: 100%; height: 400rpx; background: #eee; color: #bbb; font-size: 80rpx;
  display: flex; align-items: center; justify-content: center;
}

.info { background: #fff; padding: 30rpx; }
.price-row { display: flex; align-items: center; justify-content: space-between; }
.price { color: #C9971C; font-size: 48rpx; font-weight: 700; }
.like { color: #999; font-size: 26rpx; }
.like.liked { color: #7C6BC0; }
.title { font-size: 36rpx; font-weight: 600; color: #333; margin-top: 16rpx; }
.meta { display: flex; align-items: center; margin-top: 16rpx; }
.tag { font-size: 24rpx; color: #7C6BC0; background: #EFEBF9; padding: 4rpx 20rpx; border-radius: 20rpx; }
.time { margin-left: 20rpx; font-size: 24rpx; color: #aaa; }
.desc { font-size: 28rpx; color: #555; line-height: 1.7; margin-top: 24rpx; white-space: pre-wrap; }
.tags { display: flex; flex-wrap: wrap; margin-top: 20rpx; }
.tag-chip {
  font-size: 24rpx; color: #7C6BC0; background: #EFEBF9;
  padding: 6rpx 20rpx; border-radius: 20rpx; margin: 0 12rpx 12rpx 0;
}

.seller-card { background: #fff; margin: 20rpx; padding: 30rpx; border-radius: 16rpx; }
.seller-title { font-size: 28rpx; color: #999; }
.seller-name {
  margin-top: 12rpx; display: flex; align-items: center; flex-wrap: wrap;
}
/* 卖家头像 */
.seller-avatar { width: 64rpx; height: 64rpx; border-radius: 50%; background: #eee; flex-shrink: 0; }
.seller-avatar.placeholder {
  display: flex; align-items: center; justify-content: center; font-size: 36rpx;
}
.seller-nick { margin-left: 16rpx; font-size: 32rpx; font-weight: 600; color: #333; }
.enter-seller { margin-left: 12rpx; font-size: 24rpx; color: #9A86D9; }
/* 收到的小花数 */
.flower-count {
  margin-left: 12rpx; font-size: 26rpx; font-weight: 600; color: #d96a8a;
  background: #ffe9f0; padding: 2rpx 16rpx; border-radius: 22rpx;
}
.seller-contact {
  margin-top: 16rpx; background: #efeafb; border-radius: 12rpx; padding: 24rpx;
  font-size: 28rpx; color: #5c4d9e; display: flex; justify-content: center; align-items: center;
  border: 2rpx dashed #c9bde8;
}
.contact-mask { font-weight: 600; }
.contact-plain { font-weight: 600; color: #333; }
/* 站内私信主入口（高亮） */
.seller-contact.chat-entry {
  background: #7C6BC0; border: none; color: #fff;
}
.chat-entry-icon { margin-right: 8rpx; }
.chat-entry-text { font-weight: 600; }
.seller-contact.chat-entry .copy { color: #fff; }
/* 复制联系方式降级：弱化 */
.seller-contact.copy-secondary {
  background: #fafafa; border: 2rpx solid #eee;
  color: #999; font-size: 24rpx; padding: 16rpx;
  margin-top: 12rpx;
}
.copy { color: #7C6BC0; font-size: 28rpx; margin-left: 12rpx; }

.safety { font-size: 24rpx; color: #d32f2f; padding: 0 30rpx; line-height: 1.6; }

.report-entry { text-align: center; font-size: 24rpx; color: #bbb; padding: 16rpx 0 4rpx; }
.poster-entry {
  text-align: center; font-size: 28rpx; color: #7C6BC0;
  background: #fff; margin: 0 20rpx 20rpx; padding: 20rpx;
  border-radius: 12rpx; font-weight: 600;
}

.loading { text-align: center; color: #999; font-size: 28rpx; padding-top: 300rpx; }

.bottom-bar {
  position: fixed; left: 0; right: 0; bottom: 0;
  display: flex; align-items: center;
  padding: 12rpx 24rpx; padding-bottom: calc(12rpx + env(safe-area-inset-bottom));
  background: #fff; box-shadow: 0 -2rpx 10rpx rgba(0,0,0,0.06);
}
.contact-btn { flex: 1; background: #fff; color: #666; font-size: 22rpx; border: 2rpx solid #ddd; border-radius: 40rpx; margin-right: 12rpx; white-space: nowrap; }
.contact-btn.icon-btn { flex: 0.7; font-size: 22rpx; }
.contact-btn.text-btn { flex: 1.3; background: #fff; color: #7C6BC0; border: 2rpx solid #d9d2f0; font-size: 24rpx; }
/* 私信主按钮（高亮实心） */
.contact-btn.primary-btn {
  flex: 1.6; background: #7C6BC0; color: #fff; border: none;
  font-size: 26rpx; font-weight: 600;
}
.contact-btn.primary-btn::after { border: none; }
/* 送小花按钮：复制联系方式前置灰锁定，复制后变粉解锁 */
.flower-btn {
  flex: 0.85; font-size: 24rpx; border-radius: 40rpx; margin-right: 12rpx;
  border: 2rpx solid #f3c6d2; background: #fff; color: #d96a8a; white-space: nowrap;
}
.flower-btn.ready { background: #ffe3ec; border-color: #f3a7c2; color: #d44f7e; }
.flower-btn.locked { border-color: #ddd; background: #f5f5f5; color: #bbb; }
.fav-btn { flex: 0.7; background: #FFFBE6; color: #8a6d1a; font-size: 24rpx; border: 2rpx solid #F0E6C8; border-radius: 40rpx; white-space: nowrap; }

/* 交易状态徽标 */
.sold-badge, .pending-badge {
  display: inline-block; padding: 4rpx 20rpx; margin-right: 16rpx;
  font-size: 24rpx; border-radius: 20rpx;
}
.sold-badge { color: #999; background: #f0f0f0; border: 1rpx solid #ddd; }
.pending-badge { color: #d08a1e; background: #fdf3e3; border: 1rpx solid #f0d9a8; }

/* 已认证标识（淡紫底包边，详情页稍大） */
.verified-badge {
  margin-left: 8rpx; font-size: 22rpx; line-height: 1;
  background: #EFEBF9; color: #7C6BC0;
  border: 1rpx solid #d9d2f0; border-radius: 10rpx;
  padding: 5rpx 10rpx; display: inline-block; vertical-align: middle;
}

.fav-btn.liked { background: #FFF3C4; border-color: #E3C97A; color: #7C6BC0; }

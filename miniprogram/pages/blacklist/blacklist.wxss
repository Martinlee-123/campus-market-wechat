/* pages/blacklist/blacklist.wxss */
.page { background: #f5f5f5; min-height: 100vh; padding-bottom: 60rpx; }

.tip {
  font-size: 24rpx; color: #888; background: #EFEBF9;
  padding: 20rpx 28rpx; line-height: 1.6;
}

.list { padding: 8rpx 24rpx; }
.row {
  display: flex; align-items: center;
  background: #fff; border-radius: 16rpx; padding: 24rpx;
  margin-top: 20rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.avatar { width: 90rpx; height: 90rpx; border-radius: 50%; background: #f0f0f0; flex-shrink: 0; }
.avatar.placeholder {
  display: flex; align-items: center; justify-content: center;
  font-size: 46rpx; color: #bbb;
}
.info { flex: 1; margin-left: 22rpx; overflow: hidden; }
.name { font-size: 30rpx; font-weight: 600; color: #333; }
.verified { margin-left: 6rpx; font-size: 24rpx; }
.time { font-size: 22rpx; color: #999; margin-top: 8rpx; }
.unblock {
  font-size: 26rpx; color: #7C6BC0; background: #EFEBF9;
  padding: 12rpx 26rpx; border-radius: 30rpx; flex-shrink: 0;
}

/* 骨架屏 */
.skeleton { padding: 8rpx 24rpx; }
.sk-row {
  display: flex; align-items: center;
  background: #fff; border-radius: 16rpx; padding: 24rpx; margin-top: 20rpx;
}
.sk-avatar { width: 90rpx; height: 90rpx; border-radius: 50%; background: #e9e9ec; }
.sk-name { width: 40%; height: 30rpx; background: #e9e9ec; border-radius: 8rpx; margin-left: 22rpx; }
.sk-row .sk-avatar, .sk-row .sk-name { animation: sk-blink 1.2s ease-in-out infinite; }
@keyframes sk-blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

.empty { text-align: center; padding: 160rpx 0; }
.empty-icon { font-size: 100rpx; }
.empty-text { color: #666; font-size: 30rpx; margin-top: 20rpx; }
.empty-sub { color: #999; font-size: 24rpx; margin-top: 12rpx; }
.loading { text-align: center; color: #999; font-size: 28rpx; padding-top: 300rpx; }
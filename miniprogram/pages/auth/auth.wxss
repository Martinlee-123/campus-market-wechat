.page { background: #f5f5f5; min-height: 100vh; padding: 40rpx 30rpx; }
.card { background: #fff; border-radius: 20rpx; padding: 40rpx 30rpx; text-align: center; }
.icon { font-size: 90rpx; }
.title { font-size: 36rpx; font-weight: 700; color: #333; margin-top: 16rpx; }
.subtitle { font-size: 26rpx; color: #888; margin-top: 12rpx; line-height: 1.6; text-align: left; }

.status-box { margin-top: 30rpx; }
.status { display: inline-block; padding: 12rpx 40rpx; border-radius: 32rpx; font-size: 28rpx; background: #f0f0f0; color: #999; }
.status.verified { background: #e8f5e9; color: #2e7d32; }
.status.pending { background: #fff3e0; color: #e65100; }
.status.rejected { background: #ffebee; color: #c62828; }

.form { margin-top: 30rpx; text-align: left; }
.row { border-top: 1rpx solid #f0f0f0; padding: 24rpx 0; }
.label { font-size: 28rpx; color: #333; font-weight: 600; margin-bottom: 12rpx; }
.req { color: #e53935; }
.input { width: 100%; font-size: 30rpx; background: #f8f8f8; border-radius: 12rpx; padding: 16rpx; box-sizing: border-box; }
.rule { font-size: 24rpx; color: #7C6BC0; margin-top: 12rpx; }
.privacy { font-size: 22rpx; color: #aaa; margin-top: 12rpx; line-height: 1.5; }

.submit-btn { margin-top: 30rpx; background: #7C6BC0; color: #fff; font-size: 30rpx; border-radius: 40rpx; padding: 20rpx 0; }

/* pages/poster/poster.wxss */
.page { background: #f5f5f5; min-height: 100vh; padding: 24rpx; }

.poster-canvas {
  position: fixed; left: -9999px; top: 0;
  width: 600px; height: 800px; /* 逻辑像素与 js 一致 */
}

.preview-wrap { display: flex; justify-content: center; padding: 20rpx 0; }
.preview {
  width: 600rpx; border-radius: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.12);
}
.preview.placeholder {
  width: 600rpx; height: 800rpx; background: #fff;
  display: flex; align-items: center; justify-content: center;
  color: #bbb; font-size: 28rpx; border-radius: 16rpx;
}

.actions { display: flex; gap: 20rpx; padding: 20rpx 0; }
.btn { flex: 1; border-radius: 40rpx; font-size: 30rpx; }
.btn::after { border: none; }
.btn.save { background: #7C6BC0; color: #fff; }
.btn.share { background: #fff; color: #7C6BC0; border: 2rpx solid #d9d2f0; }
.btn[disabled] { opacity: 0.5; }

.tip { text-align: center; font-size: 24rpx; color: #999; padding: 10rpx 0 40rpx; }

.loading { text-align: center; color: #999; padding: 300rpx 0; font-size: 28rpx; }